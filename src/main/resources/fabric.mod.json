{
  "schemaVersion": 1,
  "id": "mobhighlight",
  "version": "${version}",
  "name": "Mob Highlight",
  "description": "Adds vanilla glowing outlines to nearby mobs, colored by rule. Seven auto-sorted categories plus your own custom rules, works with modded entities. Client-side only, no Mixin.",
  "icon": "assets/mobhighlight/icon.png",
  "authors": [
    "yuyou815"
  ],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/yuyou815/mobhighlight",
    "sources": "https://github.com/yuyou815/mobhighlight",
    "issues": "https://github.com/yuyou815/mobhighlight/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.mobhighlight.MobHighlightClient"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.19",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
